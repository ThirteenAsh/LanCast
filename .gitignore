# Logs and temporary files
# ------------------------------
*.log
*.tmp
*.cache

# 忽略本地配置（个人环境）
.claude/settings.local.json

# 忽略缓存和日志
.claude/cache/
.claude/logs/

# 可选：忽略临时文件
.claude/tmp/

